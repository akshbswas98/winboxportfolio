# Copy to .env for local development with `netlify dev`.
# NEVER commit a real .env — it is gitignored.
#
# .env values are read by `netlify dev` locally only.
# For production you must set these in the Netlify UI
# (Site settings > Environment variables) with the "Functions" scope enabled,
# or with:  netlify env:set NOTION_TOKEN secret_xxx
#
# Environment variables declared inside netlify.toml are NOT available to
# functions at runtime. That is a Netlify platform rule, not a mistake.

# Internal integration token.
# Create at https://www.notion.so/my-integrations , then share each database
# with the integration via "... > Connections".
NOTION_TOKEN=secret_replace_me

# Database IDs (the 32-char string in the database URL).
# You configure DATABASE ids; the function resolves the data source ID itself.
BOOKS_DB_ID=replace_me
BLOGS_DB_ID=replace_me
CERTS_DB_ID=replace_me
PROJECTS_DB_ID=replace_me